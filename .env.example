# NODE
NODE_ENV=development

# SERVER
PORT=3000

# DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/gvray_admin"

# JWT
JWT_SECRET=your-super-secret-key
JWT_ACCESS_TOKEN_EXPIRES_IN=2h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# LOGGING
LOG_LEVEL=info

# OPERATION LOG
OPLOG_ENABLED=true
OPLOG_MASK_FIELDS=password,oldPassword,newPassword,token,authorization,secret,captcha,email,phone,mobile,idCard,idCardNo,idNumber

# SECURITY
BCRYPT_ROUNDS=12

# GEO IP（登录地点解析，默认 ip-api.com；带超时与本地缓存）
GEOIP_TIMEOUT_MS=8000
GEOIP_CACHE_TTL_SECONDS=604800

# AUTH CONTEXT CACHE（/me、菜单树缓存 TTL，秒）
AUTH_CTX_CACHE_TTL=600

# SEED
SUPER_ADMIN_INITIAL_PASSWORD=123456

# TIMEZONE
APP_TZ_SUFFIX=+08:00

# CORS
ENABLE_CORS=true
CORS_ORIGINS="http://example.com,http://example.org"

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=gvr
