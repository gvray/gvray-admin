# NODE
NODE_ENV=test

# SERVER
PORT=3000

# DATABASE
DATABASE_URL="mysql://root@localhost:3306/gvray_admin"

# JWT
JWT_SECRET="your-jwt-secret"
JWT_ACCESS_TOKEN_EXPIRES_IN="2h"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# LOGGING
LOG_LEVEL=error

# OPERATION LOG
OPLOG_ENABLED=false
OPLOG_MASK_FIELDS=password,oldPassword,newPassword,token,authorization,secret,captcha

# SEED
SUPER_ADMIN_INITIAL_PASSWORD=123456

# TIMEZONE
APP_TZ_SUFFIX=+08:00

# CORS
ENABLE_CORS=true
CORS_ORIGINS=""
