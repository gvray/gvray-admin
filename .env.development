# NODE
NODE_ENV=development

# SERVER
PORT=3000

# DATABASE
# Prisma CLI 从 .env 读取，NestJS 运行时 fallback 到 .env

# JWT
JWT_SECRET="your-jwt-secret"
JWT_ACCESS_TOKEN_EXPIRES_IN="5m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# LOGGING
LOG_LEVEL=info

# OPERATION LOG
OPLOG_ENABLED=true
OPLOG_MASK_FIELDS=password,oldPassword,newPassword,token,authorization,secret,captcha

# SEED
# Prisma CLI 从 .env 读取

# TIMEZONE
APP_TZ_SUFFIX=+08:00

# CORS
ENABLE_CORS=true
CORS_ORIGINS=""

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=gvr
REDIS_DEFAULT_TTL=3600
